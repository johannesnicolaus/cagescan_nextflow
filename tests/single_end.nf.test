nextflow_pipeline {

    name "Test pipeline, single-end CAGE"
    script "../main.nf"
    tag "pipeline"
    tag "single_end"

    test("-profile test, single-end") {

        when {
            params {
                // READ1 files only: single-end CAGE (TSS clusters and counts, no CAGEscan transcripts)
                def data_dir = "${projectDir}/tests/data"
                def samplesheet = new File(new File(outputDir).parentFile, "samplesheet_se.csv")
                samplesheet.text = "sample,fastq_1,fastq_2,group\n" + ['SAMPLE1', 'SAMPLE2'].collect { s ->
                    "${s},${data_dir}/${s}_R1.fastq.gz,,A"
                }.join("\n") + "\n"
                input  = samplesheet.toString()
                outdir = "$outputDir"
            }
        }

        then {
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            def broad = path("${params.outdir}/tss_clusters/broad/all_samples.broad.tss_clusters.bed").readLines()
                .collect { line -> line.split('\t') }
            def truth = path("${projectDir}/tests/data/truth_tss.bed").readLines()
                .collect { line -> line.split('\t') }
                .findAll { f -> f[3].startsWith('gene') }
            def is_peak = { t -> broad.any { f -> f[0] == t[0] && f[5] == t[5] && Math.abs((f[6] as int) - (t[1] as int)) <= 1 } }
            assert workflow.success
            assertAll(
                // the same TSS outputs as paired-end CAGE
                { assert truth.every { t -> is_peak(t) } },
                { assert broad.any { f -> f[3].startsWith('SL') } },
                { assert path("${params.outdir}/tss_clusters/broad/all_samples.broad.tss_cluster_counts.tsv").exists() },
                { assert path("${params.outdir}/tss_clusters/broad/all_samples.broad.tss_cluster_sl_counts.tsv").exists() },
                // no CAGEscan clusters or transcripts without read pairs
                { assert !file("${params.outdir}/transcripts").exists() },
                { assert !file("${params.outdir}/cagescan_clusters").exists() },
                { assert snapshot(
                    removeNextflowVersion("${params.outdir}/pipeline_info/cagescan_software_mqc_versions.yml"),
                    stable_path,
                    stable_content
                ).match() }
            )
        }
    }
}
