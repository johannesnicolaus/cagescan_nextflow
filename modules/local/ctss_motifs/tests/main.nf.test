nextflow_process {

    name "Test Process CTSS_MOTIFS"
    script "../main.nf"
    process "CTSS_MOTIFS"

    tag "modules"
    tag "modules_local"
    tag "ctss_motifs"

    test("simulated CAGE") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/tests/data/modules/SAMPLE1.ctss.bed", checkIfExists: true),
                    file("${projectDir}/tests/data/modules/sl.ctss.bed", checkIfExists: true)
                ]
                input[1] = [
                    [ id:'genome' ],
                    file("${projectDir}/tests/data/genome.fa", checkIfExists: true),
                    file("${projectDir}/tests/data/genome.fa.fai", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def stats = path(process.out.stats[0][1]).readLines()
            assertAll(
                { assert process.success },
                { assert stats[-2].startsWith('Sample\tTSS with YR initiator (%)\tSL sites after AG (%)') },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("no spliced leader") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/tests/data/modules/SAMPLE1.ctss.bed", checkIfExists: true),
                    []
                ]
                input[1] = [
                    [ id:'genome' ],
                    file("${projectDir}/tests/data/genome.fa", checkIfExists: true),
                    file("${projectDir}/tests/data/genome.fa.fai", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert !process.out.acceptor },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("simulated CAGE - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/tests/data/modules/SAMPLE1.ctss.bed", checkIfExists: true),
                    []
                ]
                input[1] = [
                    [ id:'genome' ],
                    file("${projectDir}/tests/data/genome.fa", checkIfExists: true),
                    file("${projectDir}/tests/data/genome.fa.fai", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

}
