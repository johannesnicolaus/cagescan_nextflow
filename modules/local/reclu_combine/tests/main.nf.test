nextflow_process {

    name "Test Process RECLU_COMBINE"
    script "../main.nf"
    process "RECLU_COMBINE"

    tag "modules"
    tag "modules_local"
    tag "reclu_combine"

    test("simulated CAGE") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [ file("${projectDir}/tests/data/modules/reclu_pair.reclu_idr.tsv", checkIfExists: true) ]
                ]
                """
            }
        }

        then {
            // sharp clusters are short and do not overlap on the same strand
            def rows = path(process.out.bed[0][1]).readLines().collect { line -> line.split('\t') }
            assert rows.size() > 0
            assert rows.every { f -> (f[2] as int) - (f[1] as int) + 1 <= 200 }
            def by_strand = rows.groupBy { f -> "${f[0]}${f[5]}" }.values()
            assert by_strand.every { rs -> rs.collate(2, 1, false).every { p -> (p[0][2] as int) < (p[1][1] as int) } }
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("simulated CAGE - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [ file("${projectDir}/tests/data/modules/reclu_pair.reclu_idr.tsv", checkIfExists: true) ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

}
