nextflow_process {

    name "Test Process BAM_TO_CTSS"
    script "../main.nf"
    process "BAM_TO_CTSS"

    tag "modules"
    tag "modules_local"
    tag "bam_to_ctss"

    test("simulated CAGE") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/tests/data/modules/SAMPLE1.bam", checkIfExists: true),
                    file("${projectDir}/tests/data/modules/SAMPLE1.bam.bai", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("simulated CAGE - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/tests/data/modules/SAMPLE1.bam", checkIfExists: true),
                    file("${projectDir}/tests/data/modules/SAMPLE1.bam.bai", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

}
