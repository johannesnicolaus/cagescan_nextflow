nextflow_process {

    name "Test Process PARACLU_RAW"
    script "../main.nf"
    process "PARACLU_RAW"

    tag "modules"
    tag "modules_local"
    tag "paraclu_raw"

    test("simulated CAGE") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/tests/data/modules/reclu_SAMPLE1.ctss.bed", checkIfExists: true)
                ]
                input[1] = 2
                """
            }
        }

        then {
            // the full hierarchy is kept: some clusters contain others
            def rows = path(process.out.clusters[0][1]).readLines().findAll { line -> !line.startsWith('#') }.collect { line -> line.split('\t') }
            def nested = rows.any { a -> rows.any { b -> a != b && a[0] == b[0] && a[1] == b[1] && (a[2] as long) <= (b[2] as long) && (b[3] as long) <= (a[3] as long) } }
            assert nested
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("simulated CAGE - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/tests/data/modules/reclu_SAMPLE1.ctss.bed", checkIfExists: true)
                ]
                input[1] = 2
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

}
