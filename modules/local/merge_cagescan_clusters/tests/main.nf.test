nextflow_process {

    name "Test Process MERGE_CAGESCAN_CLUSTERS"
    script "../main.nf"
    process "MERGE_CAGESCAN_CLUSTERS"

    tag "modules"
    tag "modules_local"
    tag "merge_cagescan_clusters"

    test("simulated CAGE") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                        file("${projectDir}/tests/data/modules/SAMPLE1.cagescan_clusters.bed12", checkIfExists: true),
                        file("${projectDir}/tests/data/modules/SAMPLE2.cagescan_clusters.bed12", checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("simulated CAGE - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                        file("${projectDir}/tests/data/modules/SAMPLE1.cagescan_clusters.bed12", checkIfExists: true),
                        file("${projectDir}/tests/data/modules/SAMPLE2.cagescan_clusters.bed12", checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

}
