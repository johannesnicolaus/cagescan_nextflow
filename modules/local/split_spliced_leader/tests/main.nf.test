nextflow_process {

    name "Test Process SPLIT_SPLICED_LEADER"
    script "../main.nf"
    process "SPLIT_SPLICED_LEADER"

    tag "modules"
    tag "modules_local"
    tag "split_spliced_leader"

    test("simulated CAGE") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                        file("${projectDir}/tests/data/SAMPLE1_R1.fastq.gz", checkIfExists: true),
                        file("${projectDir}/tests/data/SAMPLE1_R2.fastq.gz", checkIfExists: true)
                    ]
                ]
                input[1] = 'GGTTTAATTACCCAAGTTTGAG'
                """
            }
        }

        then {
            def sl   = process.out.sl[0][1].collect { f -> path(f).linesGzip }
            def nosl = process.out.nosl[0][1].collect { f -> path(f).linesGzip }
            assertAll(
                { assert process.success },
                // 12,000 simulated pairs; READ1s of the trans-spliced gene start with the SL
                { assert sl[0].size() == sl[1].size() && sl[0].size() > 0 },
                { assert (sl[0].size() + nosl[0].size()) / 4 == 12000 },
                { assert sl.every { lines -> lines[0] ==~ /^@SLG?\.SL:.*/ } },
                { assert nosl.every { lines -> lines[0].startsWith('@no_adapter:') } },
                // the SL is trimmed from READ1
                { assert !sl[0].withIndex().any { line, i -> i % 4 == 1 && line.startsWith('GGTTTAATTACCCAAG') } },
                { assert snapshot((sl[0].size() / 4) as int, (nosl[0].size() / 4) as int, process.out.findAll { key, val -> key.startsWith('versions') }).match() }
            )
        }
    }

    test("simulated CAGE - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                        file("${projectDir}/tests/data/SAMPLE1_R1.fastq.gz", checkIfExists: true),
                        file("${projectDir}/tests/data/SAMPLE1_R2.fastq.gz", checkIfExists: true)
                    ]
                ]
                input[1] = 'GGTTTAATTACCCAAGTTTGAG'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("two leaders") {
        when {
            process {
                """
                input[0] = [
                    [ id:'two' ],
                    [
                        file("${projectDir}/tests/data/modules/two_leaders_R1.fastq.gz", checkIfExists: true),
                        file("${projectDir}/tests/data/modules/two_leaders_R2.fastq.gz", checkIfExists: true)
                    ]
                ]
                input[1] = 'SL1=GGTTTAATTACCCAAGTTTGAG,SL2=GGTTTTAACCCAGTTACTCAAG'
                """
            }
        }

        then {
            def heads = path(process.out.sl[0][1][0]).linesGzip.withIndex().findAll { line, i -> i % 4 == 0 }.collect { line, i -> line.split(':')[0] }
            def seqs = path(process.out.sl[0][1][0]).linesGzip.withIndex().findAll { line, i -> i % 4 == 1 }.collect { line, i -> line }
            def nosl = path(process.out.nosl[0][1][0]).linesGzip
            assertAll(
                { assert process.success },
                // each pair labelled with its leader (SLG: extra G before the leader); the leader is trimmed
                { assert heads.sort() == ['@SL.SL1', '@SL.SL1', '@SL.SL2', '@SLG.SL1', '@SLG.SL2'] },
                { assert seqs.every { seq -> seq.startsWith('A') } },
                { assert nosl.size() == 4 && nosl[0].startsWith('@no_adapter:p6') }
            )
        }
    }

    test("single-end, two leaders") {
        when {
            process {
                """
                input[0] = [
                    [ id:'se', single_end:true ],
                    [ file("${projectDir}/tests/data/modules/two_leaders_R1.fastq.gz", checkIfExists: true) ]
                ]
                input[1] = 'SL1=GGTTTAATTACCCAAGTTTGAG,SL2=GGTTTTAACCCAGTTACTCAAG'
                """
            }
        }

        then {
            def sl = [process.out.sl[0][1]].flatten()
            def heads = path(sl[0]).linesGzip.withIndex().findAll { line, i -> i % 4 == 0 }.collect { line, i -> line.split(':')[0] }
            assertAll(
                { assert process.success },
                { assert sl.size() == 1 && [process.out.nosl[0][1]].flatten().size() == 1 },
                { assert heads.sort() == ['@SL.SL1', '@SL.SL1', '@SL.SL2', '@SLG.SL1', '@SLG.SL2'] }
            )
        }
    }

}
