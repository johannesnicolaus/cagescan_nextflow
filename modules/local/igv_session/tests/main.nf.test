nextflow_process {

    name "Test Process IGV_SESSION"
    script "../main.nf"
    process "IGV_SESSION"

    tag "modules"
    tag "modules_local"
    tag "igv_session"

    test("simulated genome") {
        when {
            process {
                """
                input[0] = [
                    [ id:'genome' ],
                    file("${projectDir}/tests/data/genome.fa", checkIfExists: true),
                    file("${projectDir}/tests/data/genome.fa.fai", checkIfExists: true)
                ]
                input[1] = file("${projectDir}/tests/data/annotation.gtf", checkIfExists: true)
                input[2] = 'SAMPLE1,SAMPLE2'
                input[3] = 'broad,sharp'
                """
            }
        }

        then {
            def xml = path(process.out.session[0]).text
            assertAll(
                { assert process.success },
                // every track entry names its IGV track class, and no path is absolute
                { assert (xml =~ /<Track /).count == (xml =~ /clazz="org\.broad\.igv\.track\./).count },
                { assert !(xml =~ /(path|id|genome)="\//) },
                { assert xml.contains('genome="igv/genome.fa"') },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("simulated genome - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'genome' ],
                    file("${projectDir}/tests/data/genome.fa", checkIfExists: true),
                    file("${projectDir}/tests/data/genome.fa.fai", checkIfExists: true)
                ]
                input[1] = []
                input[2] = 'SAMPLE1'
                input[3] = 'broad'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
