nextflow_process {

    name "Test Process POOL_CTSS"
    script "../main.nf"
    process "POOL_CTSS"

    tag "modules"
    tag "modules_local"
    tag "pool_ctss"

    test("simulated CAGE") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                        file("${projectDir}/tests/data/modules/SAMPLE1.ctss.bed", checkIfExists: true),
                        file("${projectDir}/tests/data/modules/SAMPLE2.ctss.bed", checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("simulated CAGE - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                        file("${projectDir}/tests/data/modules/SAMPLE1.ctss.bed", checkIfExists: true),
                        file("${projectDir}/tests/data/modules/SAMPLE2.ctss.bed", checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

}
