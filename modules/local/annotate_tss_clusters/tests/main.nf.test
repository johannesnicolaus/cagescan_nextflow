nextflow_process {

    name "Test Process ANNOTATE_TSS_CLUSTERS"
    script "../main.nf"
    process "ANNOTATE_TSS_CLUSTERS"

    tag "modules"
    tag "modules_local"
    tag "annotate_tss_clusters"

    test("simulated CAGE") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/tests/data/modules/paraclu.bed", checkIfExists: true),
                    file("${projectDir}/tests/data/modules/pooled.ctss.bed", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("simulated CAGE - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/tests/data/modules/paraclu.bed", checkIfExists: true),
                    file("${projectDir}/tests/data/modules/pooled.ctss.bed", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

}
