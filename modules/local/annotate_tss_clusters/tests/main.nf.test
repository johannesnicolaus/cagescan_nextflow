nextflow_process {

    name "Test Process ANNOTATE_TSS_CLUSTERS"
    script "../main.nf"
    process "ANNOTATE_TSS_CLUSTERS"

    tag "modules"
    tag "modules_local"
    tag "annotate_tss_clusters"

    test("simulated CAGE") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/tests/data/modules/paraclu.bed", checkIfExists: true),
                    file("${projectDir}/tests/data/modules/pooled.ctss.bed", checkIfExists: true),
                    [], []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("simulated CAGE - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/tests/data/modules/paraclu.bed", checkIfExists: true),
                    file("${projectDir}/tests/data/modules/pooled.ctss.bed", checkIfExists: true),
                    [], []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("edge cases - neighbouring clusters are merged") {
        when {
            process {
                """
                input[0] = [
                    [ id:'edge' ],
                    file("${projectDir}/tests/data/modules/edge_paraclu.bed", checkIfExists: true),
                    file("${projectDir}/tests/data/modules/edge_pooled.ctss.bed", checkIfExists: true),
                    [], []
                ]
                """
            }
        }

        then {
            // paraclu split the chr2 TSS (extra-G shift) into two clusters 0 bp apart
            def rows = path(process.out.tsv[0][1]).readLines().tail().collect { line -> line.split('\t') }
            def chr2 = rows.findAll { r -> r[1].startsWith('chr2:') }
            assertAll(
                { assert process.success },
                { assert rows.size() == 5 },
                { assert chr2.size() == 1 },
                { assert chr2[0][3] == '5000' },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("spliced-leader clusters kept separate") {
        when {
            process {
                """
                input[0] = [
                    [ id:'sl' ],
                    file("${projectDir}/tests/data/modules/paraclu.bed", checkIfExists: true),
                    file("${projectDir}/tests/data/modules/pooled.ctss.bed", checkIfExists: true),
                    file("${projectDir}/tests/data/modules/sl_paraclu.bed", checkIfExists: true),
                    file("${projectDir}/tests/data/modules/sl.ctss.bed", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def bed = path(process.out.bed[0][1]).readLines().collect { line -> line.split('\t') }
            def sl = bed.findAll { f -> f[3].startsWith('SL') }
            assertAll(
                { assert process.success },
                // a trans-splice site 2 bp downstream of a TSS cluster gets its own SL cluster and peak
                { assert sl.size() == 2 },
                { assert sl.any { f -> f[0] == 'chr1' && f[5] == '+' && f[6] == '5006' } },
                { assert bed.any { f -> f[3].startsWith('TC') && f[0] == 'chr1' && (f[1] as int) <= 5000 && (f[2] as int) >= 5003 && f[6] == '5000' } },
                { assert snapshot(process.out).match() }
            )
        }
    }

}
