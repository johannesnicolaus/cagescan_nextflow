nextflow_process {

    name "Test Process CAGEFIGHTR_CLUSTERS"
    script "../main.nf"
    process "CAGEFIGHTR_CLUSTERS"

    tag "modules"
    tag "modules_local"
    tag "cagefightr_clusters"

    test("simulated CAGE") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                        file("${projectDir}/tests/data/modules/SAMPLE1.ctss.bed", checkIfExists: true),
                        file("${projectDir}/tests/data/modules/SAMPLE2.ctss.bed", checkIfExists: true)
                    ]
                ]
                input[1] = [ [ id:'genome' ], file("${projectDir}/tests/data/genome.fa.fai", checkIfExists: true) ]
                """
            }
        }

        then {
            def bed = path(process.out.bed[0][1]).readLines().collect { line -> line.split('\\t') }
            assertAll(
                { assert process.success },
                // the 7 simulated TSSs, each with its dominant CTSS as peak
                { assert bed.size() == 7 },
                { assert bed.any { f -> f[0] == 'chr1' && f[3] == '+' && f[4] == '5000' } },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("simulated CAGE - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'test' ], [ file("${projectDir}/tests/data/modules/SAMPLE1.ctss.bed", checkIfExists: true) ] ]
                input[1] = [ [ id:'genome' ], file("${projectDir}/tests/data/genome.fa.fai", checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

}
