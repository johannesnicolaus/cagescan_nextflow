/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    //
    // Genome preparation
    //
    withName: 'GUNZIP_.*|SAMTOOLS_FAIDX|STAR_GENOMEGENERATE' {
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    //
    // Read processing
    //
    withName: 'CAT_FASTQ' {
        publishDir = [ enabled: false ]
    }

    withName: 'FASTQC' {
        ext.args = '--quiet'
        publishDir = [
            path: { "${params.outdir}/fastqc" },
            mode: params.publish_dir_mode,
            pattern: '*.{html,zip}'
        ]
    }

    withName: 'CUTADAPT' {
        // Remove READ1 5' linker (and anything before it, e.g. barcode/UMI-like prefixes).
        ext.args = {
            [
                "-g ${params.r1_5p_linker}",
                params.linker_discard_untrimmed ? '--discard-untrimmed' : '',
                '--minimum-length 20',
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/trimming/cutadapt" },
            mode: params.publish_dir_mode,
            pattern: '*.log'
        ]
    }

    withName: 'FASTP' {
        ext.args = {
            [
                '--detect_adapter_for_pe',
                '--length_required 20',
                params.r1_trim_front ? "--trim_front1 ${params.r1_trim_front}" : '',
                params.r2_trim_front ? "--trim_front2 ${params.r2_trim_front}" : '',
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/trimming/fastp" },
            mode: params.publish_dir_mode,
            pattern: '*.{json,html,log}'
        ]
    }

    withName: 'SORTMERNA' {
        publishDir = [
            path: { "${params.outdir}/sortmerna" },
            mode: params.publish_dir_mode,
            pattern: '*.log'
        ]
    }

    //
    // Alignment
    //
    withName: 'STAR_ALIGN' {
        // Local alignment soft-clips the non-templated 5' G and any spliced leader on READ1.
        ext.args = [
            '--readFilesCommand zcat',
            '--outSAMtype BAM SortedByCoordinate',
            '--outSAMstrandField intronMotif',
            '--outSAMattributes NH HI AS nM NM MD',
            '--outFilterMultimapNmax 20',
            '--outFilterType BySJout',
            '--alignSJoverhangMin 8',
            '--alignSJDBoverhangMin 1',
            '--alignEndsType Local',
        ].join(' ')
        publishDir = [
            [
                path: { "${params.outdir}/alignment/star/log" },
                mode: params.publish_dir_mode,
                pattern: '*.{out,tab}'
            ],
            [
                path: { "${params.outdir}/alignment" },
                mode: params.publish_dir_mode,
                pattern: '*.bam',
                enabled: !params.dedup
            ]
        ]
    }

    withName: 'SAMTOOLS_COLLATE' {
        ext.prefix = { "${meta.id}.collate" }
        publishDir = [ enabled: false ]
    }

    withName: 'SAMTOOLS_FIXMATE' {
        ext.args   = '-m'
        ext.prefix = { "${meta.id}.fixmate" }
        publishDir = [ enabled: false ]
    }

    withName: 'SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}.sorted" }
        publishDir = [ enabled: false ]
    }

    withName: 'SAMTOOLS_MARKDUP' {
        ext.prefix = { "${meta.id}.markdup" }
        publishDir = [
            path: { "${params.outdir}/alignment" },
            mode: params.publish_dir_mode,
            pattern: '*.bam'
        ]
    }

    withName: 'SAMTOOLS_INDEX' {
        publishDir = [
            path: { "${params.outdir}/alignment" },
            mode: params.publish_dir_mode,
            pattern: '*.bai'
        ]
    }

    withName: 'SAMTOOLS_STATS|SAMTOOLS_FLAGSTAT|SAMTOOLS_IDXSTATS' {
        publishDir = [
            path: { "${params.outdir}/alignment/samtools_stats" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // TSS clusters
    //
    withName: 'BAM_TO_CTSS' {
        ext.args = {
            [
                "--min-mapq ${params.min_mapq}",
                params.sl_sequence ? "--sl-sequence ${params.sl_sequence}" : '',
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/ctss" },
            mode: params.publish_dir_mode,
            pattern: '*.{ctss.bed,softclip_5p.tsv}'
        ]
    }

    withName: 'UCSC_BEDGRAPHTOBIGWIG' {
        publishDir = [
            path: { "${params.outdir}/ctss/bigwig" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'POOL_CTSS' {
        publishDir = [
            path: { "${params.outdir}/tss_clusters" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'PARACLU' {
        publishDir = [ enabled: false ]
    }

    withName: 'ANNOTATE_TSS_CLUSTERS' {
        publishDir = [
            path: { "${params.outdir}/tss_clusters" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'ASSIGN_PAIRS_TO_TSS' {
        ext.args = {
            [
                "--window ${params.tss_window}",
                "--min-mapq ${params.min_mapq}",
                params.sl_sequence ? "--sl-sequence ${params.sl_sequence}" : '',
            ].join(' ').trim()
        }
        publishDir = [
            [
                path: { "${params.outdir}/tss_clusters/tss_anchored_bam" },
                mode: params.publish_dir_mode,
                pattern: '*.{bam,bai}'
            ],
            [
                path: { "${params.outdir}/cagescan_clusters" },
                mode: params.publish_dir_mode,
                pattern: '*.cagescan_clusters.bed12'
            ]
        ]
    }

    withName: 'MERGE_CAGESCAN_CLUSTERS' {
        publishDir = [
            path: { "${params.outdir}/cagescan_clusters" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MERGE_TSS_COUNTS' {
        publishDir = [
            path: { "${params.outdir}/tss_clusters" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // Transcripts
    //
    withName: 'STRINGTIE_ASSEMBLE' {
        // CAGE READ1 is sense to the transcript.
        ext.args = { "--fr -m ${params.min_transcript_length} -l ${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/stringtie/assembly" },
            mode: params.publish_dir_mode,
            pattern: '*.transcripts.gtf'
        ]
    }

    withName: 'STRINGTIE_MERGE' {
        ext.args = { "-m ${params.min_transcript_length} -l MSTRG" }
        publishDir = [
            path: { "${params.outdir}/stringtie/assembly" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'ANCHOR_TRANSCRIPTS' {
        ext.args = {
            [
                "--window ${params.tss_window}",
                params.keep_unanchored ? '--keep-unanchored' : '',
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/transcripts/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{gtf,bed12}'
        ]
    }

    withName: 'GFFREAD_GFF3' {
        ext.args   = '--keep-genes'
        ext.prefix = { "${meta.id}.transcripts" }
        publishDir = [
            path: { "${params.outdir}/transcripts/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.gff3'
        ]
    }

    withName: 'GFFREAD_FASTA' {
        ext.args   = '-w'
        ext.prefix = { "${meta.id}.transcripts" }
        publishDir = [
            path: { "${params.outdir}/transcripts/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.fasta'
        ]
    }

    withName: 'STRINGTIE_QUANT' {
        ext.args   = '--fr'
        ext.prefix = { "${meta.id}.quant" }
        publishDir = [
            path: { "${params.outdir}/quantification/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MERGE_TRANSCRIPT_COUNTS' {
        publishDir = [
            path: { "${params.outdir}/quantification" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'GFFCOMPARE' {
        publishDir = [
            path: { "${params.outdir}/gffcompare" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
