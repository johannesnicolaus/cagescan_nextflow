/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.
    The data are simulated by tests/data/make_test_data.py (two samples, six genes,
    alternative TSS / exon skipping, one spliced-leader gene).

    Use as follows (from the pipeline base directory):
        nextflow run . -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal simulated paired-end CAGE data set to check pipeline function'

    // Input data (FASTQ paths in the samplesheet are relative to the pipeline base directory)
    input       = "${projectDir}/tests/data/samplesheet.csv"
    fasta       = "${projectDir}/tests/data/genome.fa"
    gtf         = "${projectDir}/tests/data/annotation.gtf"

    // Simulated SL1 leader on one gene
    sl_sequence = 'GGTTTAATTACCCAAGTTTGAG'

    paraclu_min_cluster = 20
}
