/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.
    No public full-size paired-end CAGE data set is wired in yet: this profile runs the
    simulated data without resource limits. Point --input/--fasta/--gtf at a real data set
    to use it as a full-size test.

    Use as follows (from the pipeline base directory):
        nextflow run . -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test dataset to check pipeline function'

    input       = "${projectDir}/tests/data/samplesheet.csv"
    fasta       = "${projectDir}/tests/data/genome.fa"
    gtf         = "${projectDir}/tests/data/annotation.gtf"
    sl_sequence = 'GGTTTAATTACCCAAGTTTGAG'
}
